[configuration]

entry_symbol = "godot_nvidia_dlss_init"
compatibility_minimum = "4.7"
; The Vulkan hook is installed once per process and the DLL is pinned: it cannot be reloaded.
reloadable = false

[libraries]

windows.debug.x86_64 = "res://addons/nvidia_dlss/bin/godot_nvidia_dlss.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/nvidia_dlss/bin/godot_nvidia_dlss.windows.template_release.x86_64.dll"
