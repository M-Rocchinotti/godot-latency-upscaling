[configuration]

entry_symbol = "godot_latency_upscaling_init"
compatibility_minimum = "4.7"
; The Vulkan hook is installed once per process and the DLL is pinned: it cannot be reloaded.
reloadable = false

[libraries]

; Windows x86_64 only. The editor, games run from it and debug exports use the debug library;
; release exports use the release library, so a release zip must contain both.
; Other platforms have no library: exclude the addon from those exports (see README, "Platforms").
windows.debug.x86_64 = "res://addons/latency_upscaling/bin/godot_latency_upscaling.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/latency_upscaling/bin/godot_latency_upscaling.windows.template_release.x86_64.dll"
